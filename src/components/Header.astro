---
import { url } from '../lib/url'

const links = [
  { href: url('/docs/introduction'), label: 'Docs' },
  { href: url('/pricing'), label: 'Pricing' },
  { href: url('/cloud'), label: 'Outlet Cloud' },
]
---

<header class="sticky top-0 z-40 border-b border-ink-800 bg-ink-950/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={url('/')} class="flex items-center gap-2 font-semibold text-white">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-accent-400 font-mono text-sm font-bold text-ink-950">O</span>
      Outlet
    </a>
    <nav class="flex items-center gap-6 text-sm">
      {links.map((l) => (
        <a href={l.href} class="text-zinc-400 transition hover:text-white">{l.label}</a>
      ))}
      <a
        href="https://github.com/Leroy-Florian/Outlet-CLI"
        class="rounded-lg border border-ink-700 px-3 py-1.5 text-zinc-300 transition hover:border-zinc-500 hover:text-white"
      >
        GitHub
      </a>
      <a
        href={url('/cloud#early-access')}
        class="hidden rounded-lg bg-brand-500 px-3 py-1.5 font-medium text-white transition hover:bg-brand-600 sm:block"
      >
        Get early access
      </a>
    </nav>
  </div>
</header>
