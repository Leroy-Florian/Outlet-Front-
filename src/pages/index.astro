---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import { url } from '../lib/url'

const cliExample = `dotnet tool install -g outlet

outlet init
outlet add email-smtp
outlet list`

const diExample = `// Same port, swappable provider — switching is a one-line change.
services.AddSmtpEmail(options => options.Host = "smtp.example.com");
// services.AddSendGridEmail(options => options.ApiKey = "...");

public sealed class WelcomeNotifier(IEmailSender email)
{
    public Task SendAsync(User user) =>
        email.SendAsync(new EmailMessage(user.Address, "Welcome!", "..."));
}`

const features = [
  {
    title: 'You own the code',
    body: 'No runtime dependency on Outlet. Uninstalling it breaks nothing — the code lives in your repo and is yours to edit.',
  },
  {
    title: 'Swappable adapters',
    body: 'Each concern exposes a minimal generic port with interchangeable adapters. Switch provider behind the same port in one line of DI.',
  },
  {
    title: 'Hexagonal & tested',
    body: 'Contracts have zero external dependencies. Every registry item compiles and is tested — the manifest never lies.',
  },
  {
    title: 'Environment-aware install',
    body: 'The CLI reads evaluated MSBuild values, resolves dependencies, rewrites namespaces with Roslyn and pins everything in outlet.json.',
  },
  {
    title: 'Thin adapters by design',
    body: 'Resilience is composed on top with Polly, never baked in. Provider-specific features live in a second interface, never in the shared port.',
  },
  {
    title: 'CPM-native',
    body: 'NuGet packages are added through Central Package Management, keeping versions consistent across your whole solution.',
  },
]

const steps = [
  {
    title: 'Initialize',
    body: 'Run outlet init in your solution. Outlet detects your environment and writes an outlet.json lockfile.',
  },
  {
    title: 'Add a concern',
    body: 'Run outlet add email-smtp. Dependencies resolved, namespaces rewritten to match your project, packages added via CPM.',
  },
  {
    title: 'Own & swap',
    body: 'The code is yours: edit it freely. Want SendGrid instead of SMTP? Change one AddXxx() line — the port stays identical.',
  },
]
---

<Base title="Outlet — Copy-paste backend infrastructure for .NET">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(124,92,255,0.18),transparent)]"></div>
    <div class="mx-auto max-w-6xl px-6 pb-20 pt-24 text-center">
      <p class="mx-auto mb-6 w-fit rounded-full border border-ink-700 bg-ink-900 px-4 py-1.5 text-sm text-zinc-400">
        shadcn/ui, but for .NET backend concerns
      </p>
      <h1 class="mx-auto max-w-3xl text-5xl font-bold tracking-tight text-white sm:text-6xl">
        Backend infrastructure you
        <span class="bg-gradient-to-r from-brand-400 to-accent-400 bg-clip-text text-transparent">copy, paste and own</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-zinc-400">
        Email, cache, resilience, storage… For each concern: one generic port, several
        swappable adapters. The code lands in your repo — zero runtime dependency on Outlet.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href={url('/docs/getting-started')} class="rounded-xl bg-brand-500 px-6 py-3 font-medium text-white transition hover:bg-brand-600">
          Get started
        </a>
        <a href={url('/cloud')} class="rounded-xl border border-ink-700 px-6 py-3 font-medium text-zinc-200 transition hover:border-zinc-500">
          Discover Outlet Cloud →
        </a>
      </div>
    </div>
  </section>

  <!-- Terminal demo -->
  <section class="mx-auto grid max-w-6xl gap-6 px-6 pb-24 lg:grid-cols-2">
    <div class="overflow-hidden rounded-2xl border border-ink-700 bg-ink-900">
      <div class="flex items-center gap-2 border-b border-ink-700 px-4 py-3">
        <span class="h-3 w-3 rounded-full bg-red-400/70"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-400/70"></span>
        <span class="h-3 w-3 rounded-full bg-green-400/70"></span>
        <span class="ml-3 font-mono text-xs text-zinc-500">terminal</span>
      </div>
      <Code code={cliExample} lang="shellsession" theme="github-dark-default" class="!m-0 !rounded-none !bg-transparent p-5 text-sm" />
    </div>
    <div class="overflow-hidden rounded-2xl border border-ink-700 bg-ink-900">
      <div class="flex items-center border-b border-ink-700 px-4 py-3">
        <span class="font-mono text-xs text-zinc-500">Program.cs</span>
      </div>
      <Code code={diExample} lang="csharp" theme="github-dark-default" class="!m-0 !rounded-none !bg-transparent p-5 text-sm" />
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-ink-800 bg-ink-900/40">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center text-3xl font-bold text-white">How it works</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-zinc-400">
        Three commands between an empty project and working, provider-agnostic infrastructure.
      </p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {steps.map((s, i) => (
          <div class="rounded-2xl border border-ink-700 bg-ink-900 p-6">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-500/15 font-bold text-brand-400">{i + 1}</span>
            <h3 class="mt-4 font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-sm text-zinc-400">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-center text-3xl font-bold text-white">Built on locked-in principles</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-2xl border border-ink-800 bg-ink-900/60 p-6 transition hover:border-ink-700">
          <h3 class="font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-sm text-zinc-400">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cloud teaser -->
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="relative overflow-hidden rounded-3xl border border-brand-500/30 bg-gradient-to-br from-ink-900 to-ink-950 p-10 sm:p-14">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"></div>
      <p class="w-fit rounded-full bg-brand-500/15 px-3 py-1 text-xs font-medium uppercase tracking-wider text-brand-300">Coming soon</p>
      <h2 class="mt-4 max-w-xl text-3xl font-bold text-white">Outlet Cloud — your team's private registry, hosted</h2>
      <p class="mt-4 max-w-xl text-zinc-400">
        Private registries, team management and a hosted distribution pipeline on top of the
        open-source CLI. The registry stays copy-paste; the platform does the heavy lifting.
      </p>
      <a href={url('/cloud')} class="mt-8 inline-block rounded-xl bg-brand-500 px-6 py-3 font-medium text-white transition hover:bg-brand-600">
        Join the early access
      </a>
    </div>
  </section>
</Base>
